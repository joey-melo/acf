#!/usr/bin/env python3
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from install_tools import install
if len(sys.argv) != 2 or sys.argv[1] not in ('caido', 'ghidra', 'interactsh'):
    sys.exit('usage: acf-install caido|ghidra|interactsh')
try:
    install(sys.argv[1])
except Exception as exc:
    sys.exit(f'acf-install: {exc}')
